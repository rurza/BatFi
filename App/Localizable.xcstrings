{
  "sourceLanguage": "en",
  "strings": {
    "app_shortcut.charge_to_full.short_title": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabít baterii"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akku laden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Charge the battery"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charger la batterie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica la batteria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーを充電"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 충전"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laad de batterij op"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naładuj baterię"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregue a bateria"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарядить аккумулятор"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pili şarj et"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарядити батарею"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为电池充电"
          }
        }
      }
    },
    "Charge or run on battery power (when the lid is opened) until the limit of ${limit} is reached.": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabít nebo provozovat na baterii (při otevřeném víku), dokud není dosaženo limitu ${limit} %."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt den Akku oder wechselt auf Akkubetrieb (bei geöffnetem Deckel), bis das Limit von ${limit}% erreicht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge or run on battery power (when the lid is opened) until the limit of ${limit}% is reached."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charger ou utiliser la batterie (quand l'écran est ouvert) jusqu'a ${limit}%"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica o alimenta a batteria (con il coperchio aperto) fino al raggiungimento del limite di ${limit}%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " ${limit} の制限に達するまでバッテリーを充電するかバッテリー駆動にする(Macの蓋が開いているとき)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "${limit}% 한도에 도달할 때까지 충전하거나 (뚜껑이 열린 상태에서) 배터리로 구동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laad op of gebruik batterij (als de MacBook is opengeklapt) totdat de limiet van ${limit}% is bereikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naładuj/rozładuj baterię (gdy pokrywa z ekranem jest otwarta) dopóki limit ${limit}% nie zostanie osiągnięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregue ou utilize na bateria (com a tampa aberta) até que o limite de ${limit}% seja atingido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряжать или работать от аккумулятора (при открытой крышке), пока не будет достигнут лимит ${limit}%."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%${limit} sınırına ulaşana kadar pili şarj et ya da pil gücüyle (kapak açıkken) çalıştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряджати або працювати від батареї (при відкритій кришці), доки не буде досягнуто ліміту ${limit}%."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "充电或使用电池运行（在打开上盖时），直至达到${limit}%的限制。"
          }
        }
      }
    },
    "Charge the battery with ${applicationName}": {
