    "intent.discharge.description": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Funguje pouze s otevřeným víkem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert nur bei geöffnetem Deckel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Works only with the lid opened."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne fonctionne que si l'écran est ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona solo con il coperchio aperto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの蓋が開いている時のみ動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뚜껑이 열려 있을 때만 작동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt alleen als de MacBook is opengeklapt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa tylko gdy pokrywa z ekranem jest otwarta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona somente com a tampa aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает только при открытой крышке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece kapak açıkken çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працює тільки при відкритій кришці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在打开上盖时有效。"
          }
        }
      }
    },
