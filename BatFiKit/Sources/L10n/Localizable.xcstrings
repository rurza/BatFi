    "onboarding.label.app_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi pomáhá optimalizovat výkon baterie systému macOS tím, že inteligentně řídí úrovně nabíjení a zároveň vám dává plnou kontrolu - nabíjení na 100 %, jen když je to potřeba."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi lässt Dich die Akkuleistung deines Macs selber optimieren, oder übernimmt die intelligente Verwaltung der Ladestände. – Lade erst auf 100 %, wenn notwendig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "BatFi helps you optimize your macOS battery performance by managing charging levels intelligently, yet giving you full control – charging to 100% only when it's needed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi vous aide à optimiser les performances de la batterie de votre macOS en gérant intelligemment les niveaux de charge, tout en vous donnant un contrôle total - ne chargeant à 100% que lorsque cela est nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi ti aiuta ad ottimizzare le performance della batteria di macOS gestendo i livelli della carica in maniera intelligente, ma comunque lasciando a te il pieno controllo - carica fino al 100% quando ne hai bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFiは、必要な時のみ100%まで充電することでmacOSのバッテリーパフォーマンスを最適化することができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi는 충전 상태를 효과적으로 관리하여 macOS의 배터리 성능을 유지할 수 있도록 도와줍니다. 사용자 설정이 가능하므로 필요할 때에만 100% 충전이 가능합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi verlengt de levensduur van de batterij in je MacBook door de batterijlading slim te beheren. Jij houdt de controle om tot 100% op te laden wanneer dat nodig is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi pozwala zwiększyć wydajność baterii poprzez utrzymywanie optymalnych poziomów naładowania pozostawiając Ci pełną kontrolę – wciąż możesz ładować baterię do 100% gdy potrzeba."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi ajuda você a otimizar o desempenho da bateria do macOS gerenciando os níveis de carga de forma inteligente, mas oferecendo a você controle total – carregando até 100% somente quando necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi помогает вам оптимизировать производительность аккумулятора macOS за счет умного управления уровнями заряда, при этом предоставляя полный контроль - зарядка до 100% только тогда, когда это необходимо."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi, şarj seviyelerini akıllıca yöneterek macOS pil performansınızı iyileştirmenize yardımcı olur ve size tam kontrol sağlar - sadece gerektiğinde %100 şarj eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi допомагає оптимізувати продуктивність акумулятора macOS завдяки розумному керуванню рівнями заряду, надаючи повний контроль — заряджання до 100% тільки тоді, коли це необхідно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi通过智能化的充电限制来优化macOS电池性能以及寿命，然而你依然可以解除限制并充电至100%来满足额外的续航需求。"
          }
        }
      }
    },
