    "notifications.alert.informative_text.status_bar_icon_hidden" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li znovu otevřít nastavení aplikace BatFi, klikněte na její oznámení, vyberte její ikonu v Launchpadu nebo na ni dvakrát klikněte ve Finderu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die BatFi-Einstellungen erneut zu öffnen, klicken Sie auf die Benachrichtigung, wählen Sie das Symbol im Launchpad aus oder doppelklicken Sie im Finder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To open BatFi settings again, click its notification, select its icon in the Launchpad, or double-click it in the Finder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour rouvrir les paramètres de BatFi, cliquez sur sa notification, sélectionnez son icône dans le Launchpad ou double-cliquez dessus dans le Finder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per riaprire le impostazioni di BatFi, fai clic sulla notifica, seleziona l’icona nel Launchpad o fai doppio clic nel Finder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi設定を再度開くには、通知をクリックするか、Launchpadでアイコンを選択するか、Finderでダブルクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi 설정을 다시 열려면 알림을 클릭하거나 Launchpad에서 아이콘을 선택하거나 Finder에서 두 번 클릭하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om BatFi instellingen te openen kan je klikken op een BatFi melding, het BatFi icoon selecteren in Launchpad, of in Finder dubbelkikken op BatFi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby ponownie otworzyć ustawienia BatFi, kliknij jego powiadomienie, wybierz ikonę w Launchpadzie lub dwukrotnie kliknij w Finderze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para reabrir as configurações do BatFi, clique na notificação, selecione o ícone no Launchpad ou clique duas vezes no Finder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы снова открыть настройки BatFi, нажмите на его уведомление, выберите его значок в Launchpad или дважды щелкните по нему в Finder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi ayarlarını tekrar açmak için bildirimine tıklayın, Launchpad'deki simgesini seçin veya Finder'da çift tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб знову відкрити параметри BatFi, натисніть на його сповіщення, виберіть його значок у Launchpad або двічі клацніть на ньому у Finder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要重新打开 BatFi 设置，请点击其通知，选择 Launchpad 中的图标，或在 Finder 中双击图标。"
          }
        }
      }
    },
