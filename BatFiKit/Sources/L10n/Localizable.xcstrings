    "notifications.notification.body.battery_calibration" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpojte počítač od sítě a nechte baterii zcela vybít. Poté ji připojte a nabijte na 100 %, v případě potřeby pomocí příkazu „Nabít na 100 %“ v nabídce."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trennen Sie den Computer vom Stromnetz und lassen Sie die Batterie vollständig entladen. Schließen Sie ihn dann wieder an und laden Sie ihn auf 100 %, falls nötig mit dem Befehl „Auf 100 % laden“ im Menü."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Unplug the computer and let the battery drain completely. Then, plug it in and charge it to 100%, using the “Charge to 100%” command from the menu if needed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débrancher l'ordinateur et laisser la batterie se vider complètement. Ensuite, rebrancher l'ordinateur et charger le jusqu'à 100% en utilisant la fonction \"Charger à 100%\" du menu, si besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scollega il computer e lascia che la batteria si scarichi completamente. Quindi, collegalo e caricalo al 100% utilizzando il comando “Carica al 100%” dal menu, se necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータの電源を切り、バッテリーを完全に放電してください。その後、再接続して100％まで充電します。必要に応じて、メニューの「100％まで充電」コマンドを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터를 전원에서 분리하고 배터리를 완전히 방전시키세요. \n그런 다음 다시 연결하여 100%까지 충전하세요. \n필요시 메뉴에서 ‘100%까지 충전’ 명령을 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontkoppel de oplader en laat de batterij volledig leeglopen. Sluit de MacBook daarna weer aan en laad het apparaat op tot 100%. Gebruik indien nodig de “Opladen tot 100%” functie via het menu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odłącz komputer od ładowarki i rozładuj baterię do zera. Następnie naładuj do 100% używając polecenia “Naładuj do 100%” z menu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconecte o computador e deixe a bateria descarregar completamente. Em seguida, reconecte e carregue até 100%, usando o comando “Carregar até 100%” no menu, se necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключите компьютер от сети и полностью разрядите аккумулятор. Затем подключите его и зарядите до 100%, используя команду «Зарядить до 100%» в меню, если необходимо."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayarın fişini çekin ve pilin tamamen boşalmasını bekleyin. Ardından, fişi takıp %100'e kadar şarj edin. Gerekirse menüden ' %100 Şarj Et' komutunu kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відключіть комп’ютер від мережі та повністю розрядіть акумулятор. Потім підключіть його та зарядіть до 100%, використовуючи команду «Зарядити до 100%» у меню, якщо необхідно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "断开电脑连接，让电池完全放电。然后，重新连接并充电至 100%，如果需要，可以从菜单中使用“充电至 100%”命令。"
          }
        }
      }
