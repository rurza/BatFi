          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pil %@ olduğunda şarjı etmeyi durdur"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкніть заряджання, коли акумулятор досягне %@."
          }
        },
        "zh-Hans" : {
