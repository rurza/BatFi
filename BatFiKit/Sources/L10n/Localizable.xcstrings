    "notifications.notification.body.system_charge_limit_removed" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypadá to, že používáte macOS 15. Volba „Automaticky povolit omezení nabití systému (80 %), když Mac přejde do režimu spánku“ byla z tohoto systému macOS odstraněna"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sieht so aus, als würdest du macOS 15 verwenden. Die Option „Automatisch das System-Ladelimit (80 %) aktivieren, sobald der Mac in den Ruhezustand wechselt“ wurde aus diesem macOS entfernt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It looks like you're running on macOS 15. The \"Enable System charge limit 80% on sleep\" option was removed from this macOS"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il semble que vous utilisiez macOS 15. L’option « Activer automatiquement la limite de charge système (80 %) lorsque le Mac passe veille » a été supprimée de ce macOS"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che tu stia usando macOS 15. L’opzione \"Abilita automaticamente il limite (80%) quando il Mac va in standby\" è stata rimossa da questo macOS"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 15をお使いのようです。「Macがスリープしたら自動でシステムの充電上限(80%)を有効化する」のオプションは、このmacOSでは削除されました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 15을 사용 중인 것으로 보입니다. \"Mac이 잠자기로 전환될 경우 시스템 설정(80%)에 따라 자동으로 충전 제한\" 옵션은 이 macOS에서 제거되었습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het lijkt erop dat je macOS 15 gebruikt. De optie \"Schakel systeem-oplaadlimiet (80%) automatisch in bij sluimerstand\" is uit deze macOS verwijderd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że używasz macOS 15. Opcja \"Automatycznie włącz systemowy limit ładowania (80%) gdy Mac się usypia\" została usunięta z tego systemu macOS"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que você está no macOS 15. A opção \"Habilitar automaticamente o limite de carga do sistema (80%) quando o Mac entrar em suspensão\" foi removida deste macOS"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, вы используете macOS 15. Опция «Автоматически включать системное ограничение заряда (80 %), когда Mac переходит в спящий режим» была удалена из этой версии macOS"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görünüşe göre macOS 15 kullanıyorsunuz. “Mac uyku moduna geçtiğinde sistem şarj sınırını (%80) otomatik olarak etkinleştir” seçeneği bu macOS sürümünden kaldırıldı"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Схоже, ви використовуєте macOS 15. Опцію «Автоматично вмикати системне обмеження заряду (80%), коли Mac переходить у сплячий режим» було видалено з цієї версії macOS"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看起来你正在使用macOS 15。“当Mac进入睡眠时自动启动系统充电限制（80%）”选项已从此macOS中移除"
          }
        }
      }
    },
