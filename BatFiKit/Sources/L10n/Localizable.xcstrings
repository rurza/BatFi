    "settings.button.description.discharge_is_system_driven" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS does this on your Mac, so it keeps working with the lid closed and while asleep. BatFi isn’t doing it, so this can’t be switched off."
          }
        }
      }
    },
    "settings.button.description.lid_must_be_opened_disable_sleep" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funguje pouze s vyklopeným displejem. Chcete-li funkci používat se zaklopeným displejem, vypněte režim spánku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert nur, wenn der Deckel geöffnet ist. \nDeaktivieren Sie den Ruhezustand, um ihn im Clamshell-Modus zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Works only when the lid is open. Disable sleep to use it in clamshell mode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne uniquement lorsque le couvercle est ouvert. \nDésactivez la mise en veille pour l'utiliser en mode coque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona solo quando il coperchio è aperto. \nDisattiva il sonno per usarlo in modalità conchiglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蓋が開いているときのみ機能します。\nクラムシェルモードで使用するにはスリープを無効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뚜껑이 열려 있을 때만 작동합니다. 클램쉘 모드에서 사용하려면 수면을 비활성화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkt alleen als het deksel open is. \nSchakel slaapstand uit om het in clamshell-modus te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działa tylko, gdy ekran jest otwarty.\nWyłącz usypianie by rozładowywać baterię z zamkniętym ekranem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona apenas quando a tampa está aberta. \nDesative o modo de espera para usá-lo no modo concha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работает только при открытой крышке. \nОтключите сон, чтобы использовать в режиме ракушки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
