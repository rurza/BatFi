    "automation.help.location" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravidla podle polohy vyžadují oprávnění k polohovým službám a Wi-Fi, kterou Mac používá ke zjištění své polohy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standortregeln benötigen die Berechtigung für Ortungsdienste und WLAN, mit dem dein Mac seinen Standort bestimmt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location rules need Location Services permission and Wi-Fi, which your Mac uses to determine where it is."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles de localisation nécessitent l’autorisation du service de localisation et le Wi-Fi, que votre Mac utilise pour déterminer où il se trouve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le regole basate sulla posizione richiedono l’autorizzazione dei Servizi di localizzazione e il Wi-Fi, che il Mac usa per determinare dove si trova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所のルールには、位置情報サービスの許可と、Macが現在地を特定するために使うWi-Fiが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 규칙에는 위치 서비스 권한과, Mac이 위치를 파악하는 데 사용하는 Wi-Fi가 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locatieregels hebben toestemming voor locatievoorzieningen en wifi nodig, die je Mac gebruikt om te bepalen waar hij is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reguły lokalizacji wymagają zgody na usługi lokalizacji oraz Wi-Fi, którego Mac używa do ustalenia swojego położenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regras de local precisam de permissão dos Serviços de Localização e de Wi-Fi, que o seu Mac usa para determinar onde está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правилам по местоположению нужны разрешение на службы геолокации и Wi-Fi, по которому Mac определяет своё местоположение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum kuralları, Konum Servisleri izni ve Mac’inizin yerini belirlemek için kullandığı Wi-Fi gerektirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила за місцезнаходженням потребують дозволу служб локації та Wi-Fi, за яким Mac визначає своє розташування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置规则需要定位服务权限和Wi-Fi，Mac用它来确定自己的位置。"
          }
        }
      }
    },
    "automation.help.menu" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je pravidlo aktivní, řádek nabídek ukazuje, které pravidlo a limit platí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Regel aktiv ist, zeigt die Menüleiste, welche Regel und welches Limit gelten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While a rule is active, the menu bar shows which rule and limit are in effect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand une règle est active, la barre des menus indique quelle règle et quelle limite s’appliquent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando una regola è attiva, la barra dei menu mostra quale regola e quale limite sono in vigore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルールが有効なときは、メニューバーにどのルールと上限が適用されているかが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "규칙이 활성화되면 메뉴 막대에 어떤 규칙과 한도가 적용 중인지 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer een regel actief is, toont de menubalk welke regel en limiet van kracht zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy reguła jest aktywna, pasek menu pokazuje, która reguła i limit obowiązują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando uma regra está ativa, a barra de menus mostra qual regra e limite estão em vigor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда правило активно, строка меню показывает, какое правило и лимит действуют."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kural etkinken menü çubuğu hangi kuralın ve sınırın geçerli olduğunu gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли правило активне, рядок меню показує, яке правило та ліміт діють."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当某条规则生效时，菜单栏会显示当前生效的规则和限制。"
          }
        }
      }
    },
    "automation.help.priority" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravidla se kontrolují shora dolů — vyhrává první, jehož podmínky jsou právě splněny. Pořadí změníte přetažením."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeln werden von oben nach unten geprüft – es gewinnt die erste, deren Bedingungen gerade zutreffen. Zum Umsortieren ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rules are checked from top to bottom — the first rule whose conditions match right now wins. Drag to reorder them."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles sont évaluées de haut en bas — la première dont les conditions correspondent l’emporte. Faites glisser pour les réorganiser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le regole vengono controllate dall’alto verso il basso — vince la prima le cui condizioni corrispondono ora. Trascina per riordinarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルールは上から順に確認され、条件が現在一致する最初のルールが適用されます。ドラッグして並べ替えできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "규칙은 위에서 아래로 확인되며, 지금 조건이 맞는 첫 번째 규칙이 적용됩니다. 드래그하여 순서를 바꿀 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regels worden van boven naar beneden gecontroleerd — de eerste waarvan de voorwaarden nu kloppen, wint. Sleep om de volgorde te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reguły są sprawdzane od góry do dołu — wygrywa pierwsza, której warunki są teraz spełnione. Przeciągnij, aby zmienić kolejność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As regras são verificadas de cima para baixo — vence a primeira cujas condições correspondem agora. Arraste para reordenar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила проверяются сверху вниз — побеждает первое, чьи условия сейчас совпадают. Перетащите, чтобы изменить порядок."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurallar yukarıdan aşağıya kontrol edilir — koşulları şu anda eşleşen ilk kural geçerli olur. Sıralamak için sürükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила перевіряються згори донизу — перемагає перше, чиї умови зараз збігаються. Перетягніть, щоб змінити порядок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "规则从上到下检查——当前条件匹配的第一条规则生效。拖动可重新排序。"
          }
        }
      }
    },
    "automation.help.rules" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé pravidlo nastaví limit nabíjení, který platí, dokud jsou splněny jeho podmínky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Regel legt ein Ladelimit fest, das gilt, solange ihre Bedingungen erfüllt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each rule sets a charge limit that applies while its conditions are met."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque règle définit une limite de charge qui s’applique tant que ses conditions sont remplies."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni regola imposta un limite di ricarica che si applica quando le sue condizioni sono soddisfatte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ルールは、条件が満たされている間に適用される充電上限を設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 규칙은 조건이 충족되는 동안 적용되는 충전 한도를 설정합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke regel stelt een oplaadlimiet in die geldt zolang aan de voorwaarden wordt voldaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda reguła ustawia limit ładowania, który obowiązuje, gdy spełnione są jej warunki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada regra define um limite de carregamento que se aplica enquanto suas condições são atendidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое правило задаёт лимит заряда, который действует, пока выполняются его условия."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her kural, koşulları sağlandığı sürece geçerli olan bir şarj sınırı belirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожне правило задає ліміт заряду, який діє, поки виконуються його умови."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每条规则设置一个充电限制，在其条件满足时生效。"
          }
        }
      }
    },
