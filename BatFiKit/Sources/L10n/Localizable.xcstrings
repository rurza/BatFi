    "automation.editor.location_could_not_determine" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se zjistit polohu. Ujistěte se, že je zapnuté Wi-Fi a že jsou pro BatFi povolené polohové služby."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standort konnte nicht ermittelt werden. Stelle sicher, dass WLAN aktiviert und die Ortungsdienste für BatFi erlaubt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t determine your location. Make sure Wi-Fi is on and Location Services is enabled for BatFi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de déterminer votre position. Vérifiez que le Wi-Fi est activé et que le service de localisation est autorisé pour BatFi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile determinare la posizione. Assicurati che il Wi-Fi sia attivo e che i Servizi di localizzazione siano abilitati per BatFi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地を特定できませんでした。Wi-Fiがオンで、BatFiの位置情報サービスが有効になっていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치를 확인할 수 없습니다. Wi-Fi가 켜져 있고 BatFi의 위치 서비스가 활성화되어 있는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan je locatie niet bepalen. Zorg dat wifi aanstaat en dat locatievoorzieningen voor BatFi zijn ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się ustalić lokalizacji. Upewnij się, że Wi-Fi jest włączone, a usługi lokalizacji są aktywne dla BatFi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível determinar sua localização. Verifique se o Wi-Fi está ligado e se os Serviços de Localização estão ativados para o BatFi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось определить местоположение. Убедитесь, что Wi-Fi включён, а службы геолокации разрешены для BatFi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konumunuz belirlenemedi. Wi-Fi’nin açık ve BatFi için Konum Servisleri’nin etkin olduğundan emin olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося визначити місцезнаходження. Переконайтеся, що Wi-Fi увімкнено, а служби локації дозволено для BatFi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确定你的位置。请确保Wi-Fi已开启，并已为BatFi启用定位服务。"
          }
        }
      }
    },
    "automation.editor.location_denied" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup k poloze je odepřen. Povolte jej v Nastavení systému › Soukromí a zabezpečení › Polohové služby."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff auf den Standort verweigert. Aktiviere ihn in den Systemeinstellungen › Datenschutz & Sicherheit › Ortungsdienste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is denied. Enable it in System Settings › Privacy & Security › Location Services."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès à la localisation refusé. Activez-le dans Réglages Système › Confidentialité et sécurité › Service de localisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesso alla posizione negato. Abilitalo in Impostazioni di Sistema › Privacy e sicurezza › Servizi di localizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報へのアクセスが拒否されています。システム設定 › プライバシーとセキュリティ › 位置情報サービスで有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 접근이 거부되었습니다. 시스템 설정 › 개인정보 보호 및 보안 › 위치 서비스에서 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot locatie geweigerd. Schakel dit in via Systeeminstellingen › Privacy en beveiliging › Locatievoorzieningen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak dostępu do lokalizacji. Włącz go w Ustawieniach systemowych › Prywatność i bezpieczeństwo › Usługi lokalizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesso à localização negado. Ative em Ajustes do Sistema › Privacidade e Segurança › Serviços de Localização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к геопозиции запрещён. Включите его в Системных настройках › Конфиденциальность и безопасность › Службы геолокации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum erişimi reddedildi. Sistem Ayarları › Gizlilik ve Güvenlik › Konum Servisleri’nden etkinleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до геопозиції заборонено. Увімкніть його в Системних параметрах › Конфіденційність і безпека › Служби локації."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置访问被拒绝。请在“系统设置 › 隐私与安全性 › 定位服务”中启用。"
          }
        }
      }
    },
