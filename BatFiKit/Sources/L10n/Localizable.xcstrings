        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesso alla posizione negato. Abilitalo in Impostazioni di Sistema › Privacy e sicurezza › Servizi di localizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報へのアクセスが拒否されています。システム設定 › プライバシーとセキュリティ › 位置情報サービスで有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 접근이 거부되었습니다. 시스템 설정 › 개인정보 보호 및 보안 › 위치 서비스에서 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot locatie geweigerd. Schakel dit in via Systeeminstellingen › Privacy en beveiliging › Locatievoorzieningen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak dostępu do lokalizacji. Włącz go w Ustawieniach systemowych › Prywatność i bezpieczeństwo › Usługi lokalizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesso à localização negado. Ative em Ajustes do Sistema › Privacidade e Segurança › Serviços de Localização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к геопозиции запрещён. Включите его в Системных настройках › Конфиденциальность и безопасность › Службы геолокации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum erişimi reddedildi. Sistem Ayarları › Gizlilik ve Güvenlik › Konum Servisleri’nden etkinleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до геопозиції заборонено. Увімкніть його в Системних параметрах › Конфіденційність і безпека › Служби локації."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
