    "settings.label.magsafe_green_light_no_led" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tomto Macu není dostupné, protože nemá kontrolku MagSafe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Mac nicht verfügbar, da er keine MagSafe-Anzeigeleuchte hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not available on this Mac, which doesn't have a MagSafe indicator light."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non disponible sur ce Mac, qui ne possède pas de témoin lumineux MagSafe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non disponibile su questo Mac, che non ha una spia luminosa MagSafe."
          }
        },
        "ja" : {
          "stringUnit" : {
