    "settings.label.charge_control_limit_requires_batfi_running" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto pozastavení zajišťuje sám BatFi, takže když BatFi neběží, Mac se nabíjí normálně."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Pause kommt von BatFi selbst, sodass dein Mac ganz normal lädt, wenn BatFi nicht läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pause is BatFi’s own, so your Mac charges normally whenever BatFi isn’t running."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette pause vient de BatFi lui-même, si bien que votre Mac se recharge normalement dès que BatFi ne tourne pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pausa è di BatFi, quindi quando BatFi non è in esecuzione il Mac si ricarica normalmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この一時停止はBatFi自身によるものなので、BatFiが動いていないときMacは通常どおり充電されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 일시 정지는 BatFi가 직접 수행하므로, BatFi가 실행 중이 아닐 때는 Mac이 평소대로 충전됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die pauze komt van BatFi zelf, dus als BatFi niet draait, laadt je Mac gewoon normaal op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To wstrzymanie pochodzi od samego BatFi, więc gdy BatFi nie działa, Mac ładuje się normalnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa pausa é do próprio BatFi, então, quando o BatFi não está em execução, o Mac carrega normalmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эту паузу обеспечивает сам BatFi, поэтому когда BatFi не запущен, Mac заряжается как обычно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu duraklatmayı BatFi’nin kendisi yapar; BatFi çalışmıyorken Mac’iniz normal şekilde şarj olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цю паузу забезпечує сам BatFi, тож коли BatFi не запущено, Mac заряджається як звичайно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个暂停由BatFi自己完成，因此在BatFi未运行时，Mac会照常充电。"
          }
        }
      }
    },
