    "settings.label.diagnostics_charging_control_unsupported_explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi nemůže na tomto Macu řídit nabíjení, jeho firmware to nepodporuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi kann das Laden auf diesem Mac nicht steuern, die Firmware unterstützt das nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi can’t control charging on this Mac. Its firmware doesn’t support it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi ne peut pas contrôler la charge sur ce Mac, son micrologiciel ne le permet pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi non può controllare la ricarica su questo Mac, il suo firmware non lo supporta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファームウェアが対応していないため、BatFiはこのMacの充電を制御できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서는 펌웨어가 지원하지 않아 BatFi가 충전을 제어할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi kan het opladen op deze Mac niet regelen, de firmware ondersteunt dat niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi nie może kontrolować ładowania na tym Macu, jego firmware tego nie obsługuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O BatFi não consegue controlar o carregamento neste Mac, o firmware dele não oferece suporte a isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi не может управлять зарядкой на этом Mac, его прошивка это не поддерживает."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi bu Mac’te şarj etmeyi denetleyemiyor, donanım yazılımı bunu desteklemiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi не може керувати заряджанням на цьому Mac, його прошивка цього не підтримує."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi无法控制这台Mac的充电，其固件不支持。"
          }
        }
      }
    },
