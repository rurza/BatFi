        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このルールには条件がありません。有効にしている間は常に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 규칙에는 조건이 없습니다. 사용하는 동안 항상 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze regel heeft geen voorwaarden — hij is altijd actief zolang hij is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta reguła nie ma warunków — będzie zawsze aktywna, gdy włączona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta regra não tem condições — ela ficará sempre ativa enquanto estiver habilitada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этого правила нет условий — оно всегда активно, пока включено."
