    "automation.editor.unconditional_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto pravidlo nemá žádné podmínky — bude vždy aktivní, dokud je zapnuté."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Regel hat keine Bedingungen – sie gilt immer, solange sie eingeschaltet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This rule has no conditions — it will always be active while enabled."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette règle n’a aucune condition — elle sera toujours active tant qu’elle est activée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa regola non ha condizioni — sarà sempre attiva finché è abilitata."
