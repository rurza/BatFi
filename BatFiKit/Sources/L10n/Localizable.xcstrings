    "settings.label.magsafe_green_light_system_driven" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS turns the light green while the system charge limit is holding. BatFi isn’t pausing charging here, so this can’t be switched off."
          }
        }
      }
    },
    "settings.label.magsafe_green_light_unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tomto Macu není dostupné. Jeho firmware rozhoduje, kdy nabíjet, a nehlásí, kdy limit drží, takže BatFi nemůže kontrolce určit, kdy se má rozsvítit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Mac nicht verfügbar. Die Firmware entscheidet, wann geladen wird, und meldet nicht, wann sie das Limit hält, daher kann BatFi der Leuchte nicht mitteilen, wann sie leuchten soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not available on this Mac. Its firmware decides when to charge and doesn’t report when it’s holding, so BatFi can’t tell the light when to come on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non disponible sur ce Mac. Son micrologiciel décide quand charger et ne signale pas lorsqu'il maintient la limite, BatFi ne peut donc pas indiquer au témoin lumineux quand s'allumer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non disponibile su questo Mac. Il suo firmware decide quando ricaricare e non segnala quando sta mantenendo il limite, quindi BatFi non può indicare alla spia quando accendersi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacでは利用できません。ファームウェアが充電のタイミングを決定し、上限を維持中かどうかを報告しないため、BatFiはランプを点灯させるタイミングを指示できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서는 사용할 수 없습니다. 펌웨어가 충전 시점을 결정하고 한도를 유지 중인지 알려주지 않기 때문에, BatFi가 표시등을 켤 시점을 지정할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet beschikbaar op deze Mac. De firmware bepaalt wanneer er wordt opgeladen en meldt niet wanneer ze de limiet aanhoudt, dus BatFi kan het lampje niet vertellen wanneer het moet gaan branden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedostępne na tym Macu. Jego firmware decyduje, kiedy ładować, i nie informuje, kiedy utrzymuje limit, więc BatFi nie może wskazać światłu, kiedy ma się zaświecić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não disponível neste Mac. O firmware dele decide quando carregar e não informa quando está mantendo o limite, então o BatFi não consegue dizer à luz quando acender."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недоступно на этом Mac. Его прошивка сама решает, когда заряжать, и не сообщает, когда удерживает лимит, поэтому BatFi не может указать индикатору, когда загораться."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac’te kullanılamıyor. Ne zaman şarj edileceğine donanım yazılımı karar verir ve sınırı ne zaman koruduğunu bildirmez, bu yüzden BatFi ışığa ne zaman yanacağını söyleyemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недоступно на цьому Mac. Його прошивка сама вирішує, коли заряджати, і не повідомляє, коли утримує ліміт, тому BatFi не може вказати індикатору, коли вмикатися."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台Mac不可用。其固件决定何时充电，并且不会报告它何时在维持限制，因此BatFi无法告知指示灯何时亮起。"
          }
        }
      }
    },
