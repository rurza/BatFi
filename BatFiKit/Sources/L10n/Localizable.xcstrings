    "onboarding.label.helper_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi nainstaluje pomocný nástroj, který bude pracovat na pozadí a bude schopen změnit režim nabíjení počítače."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi wird einen Helper installieren, welcher im Hintergrund läuft und es ermöglich die Ladezustände deines Macs zu steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "BatFi will install helper tool, that will work in background and is able to change your computer's charging mode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi installera un outil d'assistance qui fonctionnera en arrière-plan et sera capable de modifier le mode de charge de votre ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi installerà uno strumento helper, che lavorerà in background ed è in grado di cambiare la modalità di carica del tuo computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFiは、バックグラウンドで動作し、コンピュータの充電モードを変更することができるヘルパーツールをインストールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi는 백그라운드에서 Mac의 충전 모드를 제어할 수 있도록 하는 보조 프로그램을 설치합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi zal een hulpprogramma installeren dat op de achtergrond werkt en de oplaadmodus van je computer kan veranderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi zainstaluje helper, który będzie działał w tle i ma możliwość zmiany trybu ładowania Twojego komputera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi instalará uma ferramenta auxiliar, que funcionará em segundo plano e será capaz de alterar o modo de carregamento do seu computador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi установит вспомогательный инструмент, который будет работать в фоновом режиме и сможет изменять режим зарядки вашего компьютера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi, arka planda çalışacak ve bilgisayarınızın şarj modunu değiştirebilecek yardımcı bir araç yükleyecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi встановить допоміжний інструмент, який працюватиме у фоновому режимі та зможе змінювати режим заряджання вашого комп’ютера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi即将安装Helper工具，它会在后台运行并更改此Mac的充电模式"
          }
        }
      }
    },
