          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles s’exécutent automatiquement. La première règle (en haut) dont les conditions sont remplies l’emporte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le regole vengono eseguite automaticamente. Vince la prima regola in alto le cui condizioni sono soddisfatte ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルールは自動的に実行されます。現在条件が一致している最上位のルールが適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "규칙은 자동으로 실행됩니다. 지금 조건이 맞는 가장 위쪽 규칙이 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regels worden automatisch uitgevoerd. De bovenste regel waarvan de voorwaarden nu kloppen, wint."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reguły działają automatycznie. Wygrywa pierwsza reguła od góry, której warunki są teraz spełnione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As regras são executadas automaticamente. Vence a primeira regra (de cima) cujas condições são atendidas agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила выполняются автоматически. Действует верхнее правило, условия которого сейчас совпадают."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurallar otomatik olarak çalışır. Koşulları şu anda eşleşen en üstteki kural geçerli olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила виконуються автоматично. Діє найвище правило, умови якого зараз збігаються."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "规则自动运行。当前条件匹配的最上方规则生效。"
          }
        }
      }
    },
