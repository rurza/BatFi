    "settings.button.tooltip.disable_automatic_sleep" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace odloží uspání, takže se počítač nabije až do limitu, a pak zablokuje nabíjení a uspí Mac"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ruhezustand wird bis zum Erreichen des festgelegte Ladelimits ausgesetzt. Anschließend wird dieser aktiviert und das Aufladen pausiert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The app will delay sleep so the computer charge up to the limit and then it'll inhibit charging and put the Mac to sleep"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application retardera la mise en veille pour permettre à l'ordinateur de se charger jusqu'à la limite, puis elle arrêtera la charge et mettra le Mac en veille"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app ritarderà la modalità di sospensione in modo che il computer si carichi fino al limite, quindi inibirà la ricarica e metterà il Mac in modalità di sospensione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリはコンピュータが充電限界まで充電するのを遅らせ、その後、充電を停止し、Macをスリープ状態にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac을 충전 제한까지 충전하기 위해 잠자기를 제한한 후, 충전을 중단하고 Mac을 잠자기로 전환합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluimerstand wordt uitgesteld zodat de computer tot de limiet oplaadt, daarna zal opladen worden gepauzeerd en zal sluimerstand geactiveerd worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apka opóźni automatycznie usypianie systemu, pozwoli naładować baterię do wyznaczonego limitu, wstrzyma ładowanie i uśpi Maca"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aplicativo atrasará a suspensão para que o computador carregue até o limite e, em seguida, inibirá o carregamento e colocará o Mac em suspensão"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение отложит переход в спящий режим, чтобы компьютер зарядился до лимита, а затем ограничит зарядку и переведет Mac в спящий режим."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama, bilgisayarın sınıra kadar şarj olması için uyku modunu geciktirecek ve ardından şarjı durdurarak Mac'i uyku moduna geçirecektir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма відкладе перехід у сплячий режим, щоб комп’ютер зарядився до ліміту, а потім обмежить заряджання та переведе Mac у сплячий режим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此应用会推迟睡眠以充电至设置的限制值，随后会停止充电并使Mac进入睡眠。"
          }
        }
      }
    },
