          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedostępne na tym Macu, który nie ma wskaźnika świetlnego MagSafe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não disponível neste Mac, que não possui uma luz indicadora MagSafe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недоступно на этом Mac, так как у него нет индикатора MagSafe."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MagSafe gösterge ışığı olmadığı için bu Mac’te kullanılamıyor."
          }
