    "settings.label.charge_control_batfi_pauses_charging" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když baterie dosáhne limitu, BatFi nabíjení pozastaví a znovu ho povolí, jakmile úroveň klesne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi pausiert das Laden, sobald dein Akku das Limit erreicht, und lässt ihn wieder laden, wenn der Ladestand sinkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi pauses charging when your battery reaches the limit, then lets it charge again when the level drops."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi met la charge en pause lorsque votre batterie atteint la limite, puis la laisse reprendre quand le niveau redescend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi mette in pausa la ricarica quando la batteria raggiunge il limite e la lascia riprendere quando il livello scende."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーが上限に達するとBatFiが充電を一時停止し、残量が下がると再び充電させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리가 한도에 도달하면 BatFi가 충전을 일시 정지하고, 잔량이 내려가면 다시 충전되도록 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatFi pauzeert het opladen zodra je batterij de limiet bereikt en laat hem weer opladen als het niveau daalt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy bateria osiągnie limit, BatFi wstrzymuje ładowanie i pozwala je wznowić, gdy poziom spadnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O BatFi pausa o carregamento quando a bateria atinge o limite e o deixa recomeçar quando o nível cai."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда аккумулятор достигает лимита, BatFi приостанавливает зарядку и снова разрешает её, когда уровень падает."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pil sınıra ulaştığında BatFi şarjı duraklatır, seviye düştüğünde ise yeniden şarj olmasına izin verir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли акумулятор досягає ліміту, BatFi призупиняє заряджання й дозволяє його знову, коли рівень падає."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当电池达到限制值时，BatFi会暂停充电；电量下降后再让它继续充电。"
          }
        }
      }
    },
