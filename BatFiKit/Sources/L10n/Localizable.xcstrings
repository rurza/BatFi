    "automation.help.conditions" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podmínky jsou volitelné. Omezte pravidlo na rozvrh (jednorázové datum nebo opakující se dny a časy) a/nebo polohu. Když nastavíte obojí, musí platit obojí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedingungen sind optional. Beschränke eine Regel auf einen Zeitplan (ein einmaliges Datum oder wiederkehrende Tage und Zeiten) und/oder einen Ort. Wenn du beides festlegst, muss beides zutreffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conditions are optional. Restrict a rule to a schedule (a one-off date or repeating days and times) and/or a location. When you set both, both must match."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conditions sont facultatives. Limitez une règle à un horaire (une date unique ou des jours et heures récurrents) et/ou à un lieu. Si vous définissez les deux, les deux doivent correspondre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le condizioni sono facoltative. Limita una regola a una pianificazione (una data singola o giorni e orari ricorrenti) e/o a un luogo. Se imposti entrambe, devono corrispondere entrambe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条件は任意です。ルールをスケジュール（1回限りの日付、または繰り返す曜日と時間帯）や場所に限定できます。両方を設定した場合は、両方が一致する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조건은 선택 사항입니다. 규칙을 일정(일회성 날짜 또는 반복되는 요일 및 시간)과/또는 위치로 제한하세요. 둘 다 설정하면 둘 다 일치해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorwaarden zijn optioneel. Beperk een regel tot een schema (een eenmalige datum of terugkerende dagen en tijden) en/of een locatie. Als je beide instelt, moeten beide kloppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warunki są opcjonalne. Ogranicz regułę do harmonogramu (jednorazowej daty lub powtarzających się dni i godzin) i/lub lokalizacji. Gdy ustawisz oba, oba muszą być spełnione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As condições são opcionais. Restrinja uma regra a uma programação (uma data única ou dias e horários recorrentes) e/ou a um local. Se você definir ambos, ambos precisam corresponder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Условия необязательны. Ограничьте правило расписанием (разовой датой либо повторяющимися днями и временем) и/или местоположением. Если задать оба, должны совпадать оба."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koşullar isteğe bağlıdır. Bir kuralı bir zamanlamayla (tek seferlik tarih ya da yinelenen gün ve saatler) ve/veya bir konumla sınırlayın. İkisini de ayarlarsanız ikisinin de eşleşmesi gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умови необов’язкові. Обмежте правило розкладом (одноразовою датою або повторюваними днями й часом) та/або місцезнаходженням. Якщо задати обидва, мають збігатися обидва."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "条件是可选的。可将规则限制为某个时间安排（单次日期或重复的星期和时间）和/或某个位置。如果同时设置，两者都必须匹配。"
          }
        }
      }
    },
