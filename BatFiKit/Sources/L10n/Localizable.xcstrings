    "automation.no_rules" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím žádná pravidla. Přidejte pravidlo pro automatizaci limitu nabíjení podle času a místa."
          }
        },
        "de" : {
          "stringUnit" : {
