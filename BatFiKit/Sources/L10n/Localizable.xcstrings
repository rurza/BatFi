            "value" : "Şarj Sınırını Ayarla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановити ліміт заряду."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置充电限制。"
          }
        }
      }
    },
    "onboarding.label.set_limit_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte maximální procento nabíjení, abyste zabránili udržování úrovně nabití na 100 % a zlepšili životnost baterie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze ein Ladelimit in Prozent, um das Aufladen auf 100 % zu verhindern und so die Lebensdauer deines Akkus zu verlängern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set a maximum charging percentage to prevent keeping charge level at 100% and improve battery longevity."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez un pourcentage de charge maximum pour éviter de maintenir le niveau de charge à 100% et améliorer la longévité de la batterie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta una percentuale di ricarica massima per evitare di mantenere il livello di carica al 100% e migliorare la longevità della batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーの寿命を伸ばすために、充電が100%のままになるのを防ぎましょう。そのために最大充電率を設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 충전 퍼센트를 설정하여 100% 충전을 제한하고 배터리 수명을 향상하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorkom opladen tot 100% zodat je batterij langer meegaat. Stel een percentage in waarna opladen gepauzeerd zal worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw maksymalny poziom naładowania by uniknąć ciągłego utrzymywania poziomu baterii na 100% i przedłużyć jej żywotność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina uma porcentagem máxima de carga para evitar manter o nível de carga em 100% e melhorar a longevidade da bateria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите максимальный процент зарядки, чтобы предотвратить поддержание уровня заряда на уровне 100% и увеличить срок службы аккумулятора."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şarj seviyesini %100'de tutmayı önlemek ve pil ömrünü uzatmak için maksimum şarj yüzdesini ayarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встановіть максимальний відсоток заряджання, щоб запобігти підтримці рівня заряду на рівні 100% і збільшити термін служби акумулятора."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置一个最大的充电百分比以防长期处于100%状态，从而提升电池的寿命。"
          }
        }
      }
    },
    "onboarding.slider.label.set_limit" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
